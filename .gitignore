# Env and secrets (never commit)
.env
.env.local
.env.*.local
app/.env
server/.env

# Dependencies
node_modules/

# Next.js
app/.next/
app/out/

# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/*/31337/
contracts/broadcast/*/16602/
contracts/broadcast/*/99999/

# Training / prediction data (but keep the trained model artifacts the
# server needs — without them the ML layer silently falls back to formula)
server/data/*
!server/data/model.json
!server/data/feature_config.json
!server/data/training_report.json

# Build output
server/dist/
*.tsbuildinfo

# Uploads (server temp)
server/uploads/

# Local mock 0G storage (testing only)
server/mock-og-storage/

# Python bytecode (ML training scripts)
__pycache__/
*.pyc

# Logs and OS
*.log
.DS_Store
